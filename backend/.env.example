# ============================================================
# Connectly - backend environment (backend services + infra)
# Copy to `.env`; compose reads this file directly.
# Frontend vars live in frontend/.env (VITE_*)
#
# Every host, credential and timeout a service needs is declared here.
# Values that protect real accounts (JWT_SECRET, INTERNAL_API_KEY,
# POSTGRES_PASSWORD) have no fallback in the code: the service refuses
# to start when they are missing rather than running with a known secret.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DATABASE=connectly-social-db
# Include SQL error detail in driver exceptions (dev aid; turn off in production)
POSTGRES_INCLUDE_ERROR_DETAIL=true
# Connections per pool. Lower it on a hosted database: every service opens its
# own pool (Social opens a second one for Hangfire) and the server counts them all.
POSTGRES_MAX_POOL_SIZE=10
POSTGRES_MIN_POOL_SIZE=0
POSTGRES_CONNECTION_TIMEOUT_SECONDS=15
POSTGRES_COMMAND_TIMEOUT_SECONDS=30
# SSL mode for the Npgsql driver: disable | require | verify-ca | verify-full
POSTGRES_SSL_MODE=disable

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
# Cloud providers (Aiven, ...) serve their public endpoint over TLS
REDIS_SSL=false
# 0 = default database
REDIS_DATABASE=0
# false = the client starts even when Redis is unreachable
REDIS_ABORT_CONNECT=false

# ---------- RabbitMQ ----------
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=connectly
RABBIT_PASSWORD=connectly_dev_password
# amqp | amqps
RABBIT_SCHEME=amqp
# RabbitMQ vhost; "/" is the default
RABBIT_VHOST=/
# Topic exchange every service publishes integration events to
RABBIT_EVENT_EXCHANGE=connectly.events
# Topic exchange failed messages are dead-lettered to
RABBIT_DEAD_LETTER_EXCHANGE=connectly.events.dlx
# Prefix for the per-service queues
RABBIT_QUEUE_PREFIX=connectly
# Prefix for the dead-letter queues
RABBIT_DEAD_LETTER_QUEUE_PREFIX=connectly.dlq
# Unacknowledged messages a consumer may hold at once
RABBIT_PREFETCH_COUNT=10
# Timeout for a single publish
RABBIT_PUBLISH_TIMEOUT_SECONDS=10
# Pause before a consumer reconnects after a crash
RABBIT_RECONNECT_DELAY_SECONDS=5
# How often a consumer checks that its connection is still alive
RABBIT_CONNECTION_POLL_MILLISECONDS=1000

# ---------- SeaweedFS ([stora] object storage, S3-compatible API) ----------
# Every S3 value lives here: nothing is hardcoded in the services.
# If the SeaweedFS instance enforces IAM, this access key must exist in it, e.g.
#   weed shell -> s3.configure -user connectly -access_key connectly -secret_key ... -apply
# A SeaweedFS started without -s3.config accepts any key.
SEAWEED_S3_ENDPOINT=http://localhost:8333
SEAWEED_S3_ACCESS_KEY=connectly
SEAWEED_S3_SECRET_KEY=connectly_dev_password
SEAWEED_S3_BUCKET=connectly
# true = HTTPS (an https:// endpoint also implies it); false = plain HTTP
SEAWEED_S3_SECURE=false
# Path-style addressing — required by SeaweedFS/MinIO
SEAWEED_S3_FORCE_PATH_STYLE=true
# Signing version: "4" (SigV4) is required by every current provider
SEAWEED_S3_SIGNATURE_VERSION=4
# true = the browser uploads straight to storage with a pre-signed URL.
# Set to false for providers that only accept the AWS chunked streaming form
# (Oracle Object Storage), then the file travels through the service.
SEAWEED_S3_DIRECT_UPLOAD=true
# true = writes carry Content-Encoding: aws-chunked (Oracle Object Storage)
SEAWEED_S3_AWS_CHUNKED=false
# SigV4 signing region (SeaweedFS ignores the value, a region is still required)
SEAWEED_S3_REGION=us-east-1
# TTL (minutes) of pre-signed URLs: PUT for client uploads, GET for reading media back
SEAWEED_S3_UPLOAD_URL_TTL_MINUTES=15
SEAWEED_S3_DOWNLOAD_URL_TTL_MINUTES=60

# ---------- Auth / JWT ----------
# REQUIRED — no default in the code. Use at least 32 random characters.
JWT_SECRET=dev_secret_change_me_min_32_chars!
JWT_ISSUER=connectly-identity
JWT_AUDIENCE=connectly-api
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=14
# Allowed clock drift when a token is validated
JWT_CLOCK_SKEW_SECONDS=30

# ---------- Password policy ----------
PASSWORD_MIN_LENGTH=8
# PBKDF2 work factor — raising it costs CPU at every sign-in
PASSWORD_HASH_ITERATIONS=100000
PASSWORD_HASH_SALT_SIZE_BYTES=16
PASSWORD_HASH_KEY_SIZE_BYTES=32

# ---------- HTTP listener ----------
# Address and scheme each service binds to
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_BIND_SCHEME=http

# ---------- Service ports ----------
GATEWAY_PORT=5000
IDENTITY_HTTP_PORT=5201
SOCIAL_HTTP_PORT=5202
CHAT_HTTP_PORT=5203
NOTIFICATION_HTTP_PORT=5204

# ---------- Service endpoints ----------
# Where the gateway routes to. Keep each address in sync with the port above.
IDENTITY_ADDRESS=http://localhost:5201
SOCIAL_ADDRESS=http://localhost:5202
CHAT_ADDRESS=http://localhost:5203
NOTIFICATION_ADDRESS=http://localhost:5204
# Base URL Identity calls to push a notification
NOTIFICATION_API_BASE=http://localhost:5204/api/v1
# Base URL Chat calls to ask about a relationship
SOCIAL_API_BASE=http://localhost:5202/api/v1
# REQUIRED — shared secret for service-to-service calls. No default in the code.
INTERNAL_API_KEY=change_me_shared_internal_key
# Timeout for service-to-service HTTP calls
INTERNAL_HTTP_TIMEOUT_SECONDS=5

# ---------- Chat message actions ----------
# How long after sending a message the sender may edit it (minutes).
CHAT_EDIT_WINDOW_MINUTES=15
# How long after sending a message the sender may recall it for everyone (minutes).
# 0 = no limit: the sender may recall a message at any time.
CHAT_UNSEND_WINDOW_MINUTES=0

# ---------- Realtime / presence ----------
# Send exception details to SignalR clients (development aid)
SIGNALR_ENABLE_DETAILED_ERRORS=true
# How often the server pings connected clients
CHAT_SIGNALR_KEEPALIVE_SECONDS=15
# How often the presence key of a connected user is refreshed
CHAT_PRESENCE_KEEPALIVE_SECONDS=40
# How long a user counts as "online" without a heartbeat
CHAT_PRESENCE_ONLINE_TTL_SECONDS=90
# How long the last-seen timestamp is kept
CHAT_PRESENCE_SEEN_TTL_DAYS=30

# ---------- Outbox ----------
# Pause between polls when there was nothing to publish
OUTBOX_IDLE_DELAY_SECONDS=2
# Pause before retrying after a failed dispatch round
OUTBOX_RETRY_DELAY_SECONDS=5
# Events published per round
OUTBOX_DISPATCH_BATCH_SIZE=50

# ---------- Geolocation ----------
# Base URL of the IP geolocation lookup used on sign-in
GEOIP_API_BASE=https://ipapi.co
GEOIP_TIMEOUT_MILLISECONDS=1500

# ---------- Media / stories / events ----------
# Largest file a client may upload (bytes) — 200 MB
MEDIA_MAX_UPLOAD_SIZE_BYTES=209715200
# How long a published story stays visible
STORY_TTL_HOURS=24
# How long an upload ticket may stay unfinished before it is abandoned
MEDIA_STALE_UPLOAD_TTL_HOURS=24
# How far in the past an event may start and still be accepted
EVENT_START_GRACE_MINUTES=5

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:3000

# ---------- Operational flags ----------
# Apply EF migrations on service startup (migrations exist in each Api project).
MIGRATE_ON_STARTUP=false
# Hangfire dashboard available at /hangfire (protect before production).
HANGFIRE_ENABLED=true
# Cron schedule of the media reconciliation job
HANGFIRE_MEDIA_RECONCILIATION_CRON=0 0 * * *
# How often a failed background job is retried, and the pauses between tries
HANGFIRE_RETRY_ATTEMPTS=3
HANGFIRE_RETRY_DELAYS_SECONDS=60,300,900

# ---------- Remember-me ----------
# Longer-lived refresh token when "Remember me" is checked at sign-in.
# Set to 0 to disable the feature (refresh tokens then always expire in JWT_REFRESH_TOKEN_TTL_DAYS).
REMEMBER_REFRESH_TTL_DAYS=90
